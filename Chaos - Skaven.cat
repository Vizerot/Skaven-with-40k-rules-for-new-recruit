        <profile name="More-More Warpstone Bullets!" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities" hidden="false" id="100c-ed40-3215-60b2">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">Once Per Turn. Your Shooting Phase. If this unit is within the 3&quot; of a friendly SKRYRE CHARACTER, this unit’s **Hail of Warpstone Bullets** has an Attacks characteristic of 6D6+3 instead of 3D6+3 for the rest of the turn. However, for each unmodified hit roll of 1 for an attack made with this unit’s **Hail of Warpstone Bullets**, inflict 1 mortal wound on this unit after the Shoot ability has been resolved.</characteristic>
          </characteristics>
        </profile>
        <profile name="Overwhelming Fire" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities" hidden="false" id="ce75-d959-a9ef-dda5">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">Add 1 to the hit roll for this unit’s **Hail of Warpstone Bullets** for attacks that target an enemy unit that has 5 or more models.</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
