                    <profile name="Cage of Warp Lightning" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities" hidden="false" id="4b4d-fba7-b39b-110c">
                      <characteristics>
                        <characteristic name="Description" typeId="9b8f-694b-e5e-b573">During your shoot phase, pick a visible enemy unit within 6&quot; of the bearer and roll a dice. On a 2+ the target has Fight-Last this turn. On a 1, inflict 1 mortal wound on the bearer.</characteristic>
                      </characteristics>
                    </profile>
                  </profiles>
