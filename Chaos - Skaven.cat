        <profile name="Shadowy Killer" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities" hidden="false" id="9433-12d4-c328-587f">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">This unit may attack enemy units that use FALL BACK to leave its engagement range with all Melee Weapons and/or Ranged Weapons with the Pistol keyword.</characteristic>
          </characteristics>
        </profile>
        <profile name="Cloak of Shadows" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities" hidden="false" id="ee9b-fdbc-e890-db15">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">After using the FALL BACK action this unit can&apos;t be targeted by ranged attacks while melee attacks have a -1 penalty to hit until its next command phase.</characteristic>
          </characteristics>
        </profile>
        <profile name="Master Assassin" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities" hidden="false" id="68f8-c67a-0908-ac19">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">While attacking a character unit, this unit can reroll all rolls of 1 during hit rolls, wound rolls, and damage rolls.</characteristic>
          </characteristics>
        </profile>
        <profile name="Sneaky Infiltrators" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities" hidden="false" id="7f85-6ccc-5400-bba5">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">While each model in this unit is wholly within 3&quot; of any terrain features, this unit cannot be targeted by shooting attacks unless the attacking model is within 9&quot; of it.</characteristic>
          </characteristics>
        </profile>
      </profiles>
      <selectionEntries>
