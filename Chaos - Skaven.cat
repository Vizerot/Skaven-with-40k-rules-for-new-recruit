      <profiles>
        <profile name="Fissures In Reality" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities" hidden="false" id="dcb3-a5d3-88b2-5a7a">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">When this unit is in combat and has fought, the unit(s) it has fought against must take a Battle-Shock test, if they fail, they also take D3 mortal wounds.</characteristic>
          </characteristics>
        </profile>
        <profile name="Prophet of the Horned Rat" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities" hidden="false" id="a05c-3b21-3295-e36e">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">During your command phase, make one of the following predictions for this round:

• **Filled With Cheese Holes**: Pick a friendly SKAVEN unit, if its ranged weapons bring an enemy unit below half-strength this round, its ranged weapons gain +1 damage for the rest of the battle.
• **Vermin Swarm**: Pick 3 friendly SKAVEN units, if they successfully charge the same target, they gain 2&quot; to charge rolls for the rest of the battle.
• **Ripped in Twain**: Pick a friendly SKAVEN unit, if its melee weapons bring an enemy unit below half-strength this round, its melee weapons gain +1 damage for the rest of the battle.</characteristic>
          </characteristics>
        </profile>
        <profile name="Vizzik Skour, Prophet of the Horned Rat" typeId="c547-1836-d8a-ff4f" typeName="Unit" hidden="false" id="6a47-6202-1bc3-27b8">
          <characteristics>
            <characteristic name="M" typeId="e703-ecb6-5ce7-aec1">10&quot;</characteristic>
            <characteristic name="T" typeId="d29d-cf75-fc2d-34a4">10</characteristic>
            <characteristic name="SV" typeId="450-a17e-9d5e-29da">5+</characteristic>
            <characteristic name="W" typeId="750a-a2ec-90d3-21fe">17</characteristic>
            <characteristic name="LD" typeId="58d2-b879-49c7-43bc">5+</characteristic>
            <characteristic name="OC" typeId="bef7-942a-1a23-59f8">7</characteristic>
          </characteristics>
        </profile>
