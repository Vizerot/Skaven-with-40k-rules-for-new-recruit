          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">End of Any Turn. Heal (D3) this unit.</characteristic>
          </characteristics>
        </profile>
        <profile name="Leader" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities" hidden="false" id="ce37-92a0-c23e-2f14">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">This model can be attached to the following units:
■ Rat Ogors
■ Stormfiends</characteristic>
          </characteristics>
        </profile>
      </profiles>
