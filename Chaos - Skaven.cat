                      <characteristics>
                        <characteristic name="Description" typeId="9b8f-694b-e5e-b573">Once Per Battle, Any Fight Phase: Pick a friendly non-CHARACTER SKAVEN INFANTRY unit wholly within 13&quot; of the bearer to be the target. Inflict D3 mortal wounds on the target. Then, add 1 to the Attacks characteristic of the target’s melee weapons for the rest of the turn.</characteristic>
                      </characteristics>
                    </profile>
                  </profiles>
                  <constraints>
                    <constraint type="max" value="1" field="selections" scope="parent" shared="true" id="6616-dc0b-e89b-46fb" includeChildSelections="false"/>
                    <constraint type="max" value="1" field="selections" scope="force" shared="true" id="11dc-879a-64ca-2c9f" includeChildSelections="true" includeChildForces="true"/>
