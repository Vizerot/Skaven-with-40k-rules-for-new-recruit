        <profile name="Boneripper Rampage" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities" hidden="false" id="2ccc-c48c-a83e-2162">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">Upon a succesful charge, the target must take D3 mortal wounds.</characteristic>
          </characteristics>
        </profile>
        <profile name="More-More Psychic Energy!" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities" hidden="false" id="82b1-34d5-6b3c-f7a3">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">Once Per Turn. Your Shooting Phase. You may roll a a dice, on a 1-3 take mortal wounds corresponding to the result. On a result of 4-6: your **Psychic** weapons gain **Lethal Hits** for the rest of your turn.</characteristic>
          </characteristics>
        </profile>
