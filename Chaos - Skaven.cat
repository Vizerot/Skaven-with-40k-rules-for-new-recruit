        <profile name="Bearer of The Sacret Tome" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities" hidden="false" id="49cb-3b04-6b29-26f4">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">After making an attack with Liber Bubonicus, the enemy unit hit is forced to make a battleshock and take 1D3 mortal wounds during every upcoming command phase. This effect can only be applied to one unit at a time and is removed once the target unit succeds a battleshock test.</characteristic>
          </characteristics>
        </profile>
        <profile name="Corrupting Influence" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities" hidden="false" id="ef9f-28fb-c1f5-9dc9">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">Subtract 1 from Save and Invulnerable Save rolls for enemy units while they are within 13&quot; of this unit.</characteristic>
          </characteristics>
        </profile>
      </profiles>
