        <profile name="Killing Blow" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities" hidden="false" id="0363-aeec-9aa2-930c">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">If this unit destroys an enemy unit, roll a dice. On a 4-6, an enemy unit of your choice that is wholly within 13&quot; of this unit becomes Battle Shocked. On a 1-3 the weapon that destroyed the enemy unit gains +3 to its damage characteristic until the end of your next turn.</characteristic>
          </characteristics>
        </profile>
