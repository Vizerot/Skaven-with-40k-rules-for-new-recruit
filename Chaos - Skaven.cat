          </modifiers>
        </infoLink>
        <infoLink name="Regenerating Monstrosity" id="b515-067e-ef6b-6ecf" hidden="false" type="profile" targetId="b6c3-e0d6-5261-183a"/>
      </infoLinks>
      <profiles>
        <profile name="Avalanche of Flesh" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities" hidden="false" id="ab55-332c-5c29-3d01">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">Each time this model ends a Charge move, select one enemy unit within Engagement Range of it and roll one D6: on a 2-3, that enemy unit suffers D3 mortal wounds; on a 4-5, that enemy unit suffers 3 mortal wounds; on a 6, that enemy unit suffers D3+3 mortal wounds and is battleshocked. If that unit has the *Infantry* Keyword, instead on a 2-3, 1D3 models in that unit suffer 1D3 mortal wounds, on a 4-5, 1D3 + 2 Models in that unit suffer 1D3 mortal wounds; on a 6, 2D3 + 3 units suffer D3 mortal wounds and this unit is battleshocked.</characteristic>
          </characteristics>
        </profile>
        <profile name="Too Horrible to Die" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities" hidden="false" id="4c94-c78f-29f8-ba66">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">The first time this unit would be destroyed, before removing it from the battlefield, roll a dice and apply the corresponding effect:
- **1 Dead**: This unit is destroyed.
- **2-3 The Rats Emerge**: This unit dies and creates 3 **Rat Swarm** units in its place, These units are created after this units **Deadly Demise* has went off.
- **4-6 It’s Alive!**: This unit is not destroyed. Bring this model back with 2D6 Wounds + 2.</characteristic>
          </characteristics>
        </profile>
        <profile name="Hell Pit Abomination" typeId="c547-1836-d8a-ff4f" typeName="Unit" hidden="false" id="5020-325c-09c9-7cae">
          <characteristics>
            <characteristic name="M" typeId="e703-ecb6-5ce7-aec1">10&quot;</characteristic>
            <characteristic name="T" typeId="d29d-cf75-fc2d-34a4">15</characteristic>
            <characteristic name="SV" typeId="450-a17e-9d5e-29da">4+</characteristic>
            <characteristic name="W" typeId="750a-a2ec-90d3-21fe">26</characteristic>
            <characteristic name="LD" typeId="58d2-b879-49c7-43bc">7+</characteristic>
            <characteristic name="OC" typeId="bef7-942a-1a23-59f8">5</characteristic>
          </characteristics>
        </profile>
        <profile name="Apex Beast" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities" hidden="false" id="c16a-90db-85ce-4fb4">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">Each time this model makes an attack that targets a unit that is Battle-shocked, add 1 to the Hit roll.</characteristic>
          </characteristics>
        </profile>
        <profile name="Unstopable Force" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities" hidden="false" id="0479-4cae-98dc-1db4">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">This unit can pass through other models and the engagement ranges of enemy units, but it cannot end that move in combat. Then, pick up to 3 enemy units that this unit passed across during that move to be the targets. Roll a D6 on a 4+ those units take 1D3 Mortal Wounds. If the target is an **Infantry** unit roll an additional D6 for every 5 models in that unit.</characteristic>
          </characteristics>
        </profile>
        <profile name="Transport" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities" hidden="false" id="0308-9ed6-e975-7b91">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">This model has a transport capacity of 20 **Skaven** **Beast** or **Swarm** models. Each model with a Wounds characteristic of more than 1 takes up the space of 3 models.</characteristic>
          </characteristics>
        </profile>
      </profiles>
