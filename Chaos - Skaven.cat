                      <characteristics>
                        <characteristic name="Description" typeId="9b8f-694b-e5e-b573">The Attack characteristic&apos;s of the bearer&apos;s ranged weapons gains + 3 attacks.</characteristic>
                      </characteristics>
                    </profile>
                  </profiles>
                  <constraints>
