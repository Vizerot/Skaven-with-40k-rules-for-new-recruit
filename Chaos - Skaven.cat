            <characteristic name="OC" typeId="bef7-942a-1a23-59f8">5</characteristic>
          </characteristics>
        </profile>
        <profile name="Leader" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities" hidden="false" id="a3c2-8b7d-718b-17a8">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">This model can be attached to the following units:
■ **Plague Monks**
■ **Plague Pack**
■ **Plague Monk Censer Bearers**</characteristic>
          </characteristics>
        </profile>
        <profile name="Altar of the Great Corruptor" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities" hidden="false" id="f2e8-fd48-8220-53a3">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">Altar of the Great Corruptor: Friendly PESTILENS units have Feel No Pain (6+) while they are wholly within 13&quot; of this unit.</characteristic>
          </characteristics>
        </profile>
      </profiles>
