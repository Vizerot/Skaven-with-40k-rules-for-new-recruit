          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">Any WEAPON TEAM unit attached to this character gains additional 1D3 attacks, +1 AP and +1 to hit at the cost of gaining 4 **HAZARDOUSE**.</characteristic>
