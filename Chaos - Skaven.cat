                  </costs>
                </selectionEntry>
                <selectionEntry type="upgrade" import="true" name="Warpstone Hyper Explosion" hidden="false" id="d185-65c1-eb41-0b58">
                  <profiles>
                    <profile name="Warpstone Hyper Explosion" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities" hidden="false" id="848d-c6e5-31b5-bfdd">
                      <characteristics>
                        <characteristic name="Description" typeId="9b8f-694b-e5e-b573">When the bearer triggers **Deadly Demise**, it is now **Deadly Demise D6** instead of the original value. Additionally, the range of **Deadly Demise** is now 12&quot; instead of 6&quot;.</characteristic>
                      </characteristics>
                    </profile>
                  </profiles>
                  <constraints>
