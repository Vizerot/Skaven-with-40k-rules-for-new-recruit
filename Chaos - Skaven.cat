      <profiles>
        <profile name="Tyrant of Battle" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities" hidden="false" id="9f45-2ffd-7051-1bd4">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">While a friendly **Verminus** unit is wholly within 13&quot; of this unit, they may re-roll their wound rolls.</characteristic>
          </characteristics>
        </profile>
        <profile name="Killing Blow" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities" hidden="false" id="0363-aeec-9aa2-930c">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">If this unit destroys an enemy unit, roll a dice. On a 1-3, an enemy unit of your choice that is within 13&quot; of this unit becomes Battle Shocked. On a 4-6, the weapon that destroyed the enemy unit gains +3 to its damage and Strength characteristic until the end of your next turn.</characteristic>
          </characteristics>
        </profile>
        <profile name="Verminlord Warbringer" typeId="c547-1836-d8a-ff4f" typeName="Unit" hidden="false" id="5937-9f1f-e11d-68e7">
          <characteristics>
