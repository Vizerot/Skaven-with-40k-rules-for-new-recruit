        <profile name="Bomb Rat" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities" hidden="false" id="50a8-2966-7f39-9814">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">If this unit is killed and it still has at least one **Bomb Rat** token, **Deadly Demise** is triggered for each **Bomb Rat* token remaining as if it was killed.</characteristic>
          </characteristics>
        </profile>
        <profile name="Shadowy Killers" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities" hidden="false" id="8650-a2b2-7222-5e2b">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">This unit may attack enemy units that use FALL BACK to leave its engagement range with all Melee Weapons and/or Ranged Weapons with the Pistol keyword.</characteristic>
          </characteristics>
        </profile>
        <profile name="Bomb Rat" typeId="c547-1836-d8a-ff4f" typeName="Unit" hidden="false" id="4c0e-e449-f92f-ae4c">
          <characteristics>
            <characteristic name="M" typeId="e703-ecb6-5ce7-aec1">8&apos;&apos;</characteristic>
            <characteristic name="T" typeId="d29d-cf75-fc2d-34a4">1</characteristic>
