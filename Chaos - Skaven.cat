        <characteristic name="D" typeId="a354-c1c8-a745-f9e3">2</characteristic>
        <characteristic name="Keywords" typeId="7f1b-8591-2fcf-d01c">Devastating Wounds, Hazardous, Psychic, Pistol, Torrent</characteristic>
      </characteristics>
    </profile>
    <profile name="➤ Winds of Plague - Breeze" typeId="f77d-b953-8fa4-b762" typeName="Ranged Weapons" hidden="false" id="c2d3-d543-f221-ede6">
      <characteristics>
        <characteristic name="Range" typeId="9896-9419-16a1-92fc">12&quot;</characteristic>
        <characteristic name="A" typeId="3bb-c35f-f54-fb08">3</characteristic>
        <characteristic name="BS" typeId="94d-8a98-cf90-183e">-</characteristic>
