      <profiles>
        <profile name="Lord of Great Plagues" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities" hidden="false" id="2ecf-be36-53e2-5755">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">If this unit is in your army, **Plague Lands** deals damage on rolls of 5+. If there is a unit with **Pestilense** keyword on that objective, damage is dealt on a 4+ instead.</characteristic>
          </characteristics>
        </profile>
        <profile name="Plaguemaster" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities" hidden="false" id="1029-34eb-b12c-d584">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">If an enemy unit were to hit this unit in melee, they must roll a dice after resolving their attack. On 4+ the strength characteristics of their Melee Weapons are reduced by half (rounded up) of its original value until the end of their next turn. On 1-3 they suffer no penalty and on a 6 they suffer 3 mortal wounds per 5 models in that unit.</characteristic>
          </characteristics>
        </profile>
        <profile name="Verminlord Corruptor" typeId="c547-1836-d8a-ff4f" typeName="Unit" hidden="false" id="83ba-ea9b-3070-ecb1">
          <characteristics>
            <characteristic name="M" typeId="e703-ecb6-5ce7-aec1">18&quot;</characteristic>
