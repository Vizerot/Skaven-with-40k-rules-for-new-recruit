            <characteristic name="W" typeId="750a-a2ec-90d3-21fe">1</characteristic>
            <characteristic name="LD" typeId="58d2-b879-49c7-43bc">12+</characteristic>
            <characteristic name="OC" typeId="bef7-942a-1a23-59f8">0</characteristic>
          </characteristics>
        </profile>
        <profile name="Bomb Rat" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities" hidden="false" id="416e-39ac-ab03-a385">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">This unit has 2 **Bomb Rat** tokens. Once per your Command Phase you can create a **Bomb Rat** model anywhere within engangment range of this unit and at least 6&quot; from any enemy models.. When you create a **Bomb Rat**, remove one **Bomb Rat** token.</characteristic>
          </characteristics>
        </profile>
        <profile name="Sneaky Infiltrators" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities" hidden="false" id="a471-6b19-0b65-e7d4">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">While each model in this unit is wholly within 3&quot; of any terrain features, this unit cannot be targeted by shooting attacks unless the attacking model is within 9&quot; of it.</characteristic>
          </characteristics>
        </profile>
      </profiles>
