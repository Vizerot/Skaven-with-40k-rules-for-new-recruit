            </selectionEntryGroup>
            <selectionEntryGroup name="Warpcog Convocation Enhancements" id="c010-2d8b-a743-6448" hidden="true" flatten="true">
              <selectionEntries>
                <selectionEntry type="upgrade" import="true" name="Pit Tinkerer" hidden="false" id="a6a7-c860-d2aa-2a02">
                  <profiles>
                    <profile name="Pit Tinkerer" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities" hidden="false" id="4c77-eff0-12eb-b221">
                      <characteristics>
                        <characteristic name="Description" typeId="9b8f-694b-e5e-b573">You can re-roll the random characteristic rolls for the Move characteristic of friendly SKRYRE VEHICLE and SKRYRE MOUNTED units while they are wholly within 13&quot; of the bearer. In addition, each time a friendly SKRYRE MOUNTED unit that is wholly within 18&quot; of this unit uses the **Rolling Doom’**or **Whirling Doom** ability, add 1 to the amount of mortal wounds inflicted, if any.</characteristic>
                      </characteristics>
                    </profile>
                  </profiles>
                  <constraints>
