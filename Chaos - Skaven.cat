                <selectionEntry type="upgrade" import="true" name="Disease-Ridden Weapon" hidden="false" id="18d4-9f6d-c25b-8119">
                  <profiles>
                    <profile name="Disease-Ridden Weapon" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities" hidden="false" id="a4ea-5ced-c1b0-9342">
                      <characteristics>
                        <characteristic name="Description" typeId="9b8f-694b-e5e-b573">For each hit the bearer lands on an enemy unit with their melee weapons, subtract 1 from the enemy unit&apos;s Save characteristic to a max of 6 for the rest of the phase.</characteristic>
                      </characteristics>
                    </profile>
                  </profiles>
