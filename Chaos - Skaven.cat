        <profile name="Spreaders of Filth and Disease" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities" hidden="false" id="4cbd-1ae5-c9ad-eec3">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">After the Fight ability has been resolved, each time a model in this unit was slain by melee attacks: roll Deadly Demise 1 and apply mortal wounds on non-PESTILENS units.</characteristic>
          </characteristics>
        </profile>
        <profile name="Plague Lands" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities" hidden="false" id="8fb6-a0bb-0f6a-b9f4">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">If you control an Objective Marker at the end of your command phase and this unit is within range of that Objective Marker, that Objective Marker is considered Difficult Terrain and all non-PESTILENS units within range of the Objective Marker roll a dice, where on a 6+ they take 1 mortal wound.</characteristic>
          </characteristics>
        </profile>
        <profile name="Plague Monks Champion" typeId="c547-1836-d8a-ff4f" typeName="Unit" hidden="false" id="d8ef-2cd2-3f5b-5529">
