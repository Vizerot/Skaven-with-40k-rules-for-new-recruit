            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">This model can be attached to the following units:
■ Warplock Jezzails</characteristic>
          </characteristics>
        </profile>
        <profile name="Sniper-master" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities" hidden="false" id="4872-cd78-b908-db02">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">While this model is leading a unit: all models in this unit can ignore the effects of **Stealth** and **Lone Operative**.</characteristic>
          </characteristics>
        </profile>
      </profiles>
