                <selectionEntry type="upgrade" import="true" name="Get Back in the Fight-Fight!" hidden="false" id="63d4-86ec-7af3-8f8e">
                  <profiles>
                    <profile name="Stay in the Fight-Fight!" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities" hidden="false" id="cf57-4bee-7e4c-4c69">
                      <characteristics>
                        <characteristic name="Description" typeId="9b8f-694b-e5e-b573">When a friendly SKAVEN INFANTRY unit fails a Leadership test within 5&quot; of the bearer, you may have it take 1 Mortal Wound and it is no longer Battle-Shocked.</characteristic>
