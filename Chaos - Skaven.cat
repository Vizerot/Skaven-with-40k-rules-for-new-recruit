              <characteristics>
                <characteristic name="M" typeId="e703-ecb6-5ce7-aec1">0&quot;</characteristic>
                <characteristic name="T" typeId="d29d-cf75-fc2d-34a4">8</characteristic>
                <characteristic name="SV" typeId="450-a17e-9d5e-29da">6+</characteristic>
                <characteristic name="W" typeId="750a-a2ec-90d3-21fe">7</characteristic>
                <characteristic name="LD" typeId="58d2-b879-49c7-43bc">7+</characteristic>
                <characteristic name="OC" typeId="bef7-942a-1a23-59f8">0</characteristic>
              </characteristics>
            </profile>
            <profile name="Warp Lightning Bolts" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities" hidden="false" id="1efa-20d9-0300-4e29">
              <characteristics>
                <characteristic name="Description" typeId="9b8f-694b-e5e-b573">Any Command Phase. If this unit was not set up this turn, pick each enemy unit within 6&quot; of this unit to be the targets. Roll a dice for each target. On a 4+, inflict D3 mortal wounds on the target.</characteristic>
              </characteristics>
            </profile>
            <profile name="Multiple Parts" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities" hidden="false" id="ce95-d344-823d-af6c">
              <characteristics>
                <characteristic name="Description" typeId="9b8f-694b-e5e-b573">When a number of damage points equal to this unit&apos;s Health characteristic are allocated to it, this unit is destroyed and all its parts are removed from play.</characteristic>
              </characteristics>
            </profile>
            <profile name="Warp Vortex" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities" hidden="false" id="ebae-f968-01e3-f2e3">
              <characteristics>
                <characteristic name="Description" typeId="9b8f-694b-e5e-b573">Subtract 2 from advance rolls and charge rolls for enemy units while they are within 6&quot; of this unit. In addition, if an enemy unit passes across this unit and/or the round-cornered triangle formed by drawing a line around all the bases of the unit&apos;s parts, inflict D3 mortal damage on that enemy unit after the move ability has been resolved.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
      </selectionEntries>
      <profiles>
        <profile name="Divine the Future" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities" hidden="false" id="7548-f9c6-9eda-f871">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">While friendly SKAVEN units are within 13&quot; of this unit, they may add 1 to their save and wound rolls.</characteristic>
          </characteristics>
        </profile>
        <profile name="Arch-Manipulator" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities" hidden="false" id="6aa8-be79-2889-30da">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">If your opponent were to use a stratagem on a unit within 13&quot; of this unit, roll a dice. On a 4-5 you may change the target of the stratagem to a different eligible unit, on a 6 you may stop it from being used instead. Command points are still used even if the strategem was canceled.</characteristic>
          </characteristics>
        </profile>
        <profile name="Hurl Scry-orb" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities" hidden="false" id="0030-4824-5bb9-a76a">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">At the start of your Command Phase. You may sacrifice the ability to use the *Divine The Future* ability, if you do so, deploy a WARP LIGHTNING VORTEX wholly within 36&quot; of this unit.</characteristic>
          </characteristics>
        </profile>
        <profile name="Verminlord Warpseer" typeId="c547-1836-d8a-ff4f" typeName="Unit" hidden="false" id="1ee3-e907-34a6-362b">
          <characteristics>
            <characteristic name="M" typeId="e703-ecb6-5ce7-aec1">10&quot;</characteristic>
