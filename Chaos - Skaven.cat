        <profile name="Seething Swarm" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities" hidden="false" id="830e-23fb-eb2a-388e">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">At the beginning of each player&apos;s command phase. Return D3 slain non-character models to this unit.</characteristic>
          </characteristics>
        </profile>
        <profile name="Strength in Numbers" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities" hidden="false" id="af89-4dac-4d06-8edf">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">When 2 or more units with this ability are within 3&quot; of each other they all gain +1 to hit and + 2 to their toughness.</characteristic>
          </characteristics>
        </profile>
