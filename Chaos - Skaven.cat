                    <cost name="Blackstone Fragments" typeId="ac6b-ced3-9b5e-9a6e" value="0"/>
                  </costs>
                </selectionEntry>
                <selectionEntry type="upgrade" import="true" name="Warpstone Laced Bullets" hidden="false" id="2bfd-d030-9551-8534">
                  <profiles>
                    <profile name="Warpstone Laced Bullets" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities" hidden="false" id="38ec-4a10-a32b-ddf1">
                      <characteristics>
                        <characteristic name="Description" typeId="9b8f-694b-e5e-b573">During your shooting phase, pick a friendly SKAVEN unit wholly within 13&quot; of the bearer, select one of their Ranged Weapons and give it Lethal Hits and Devastating Wounds for the rest of the phase.</characteristic>
                      </characteristics>
                    </profile>
                  </profiles>
                  <constraints>
                    <constraint type="max" value="1" field="selections" scope="parent" shared="true" id="6864-1da2-3d08-b947" includeChildSelections="false"/>
                    <constraint type="max" value="1" field="selections" scope="force" shared="true" id="3d3e-2a4e-62c8-61eb" includeChildSelections="true" includeChildForces="true"/>
                  </constraints>
