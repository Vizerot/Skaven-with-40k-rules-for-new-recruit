    <profile name="Part of The Team" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities" hidden="false" id="1c54-420b-fe0c-963d">
      <characteristics>
        <characteristic name="Description" typeId="9b8f-694b-e5e-b573">Units attached to this unit can benefit from their &quot;Hidden Weapon Team&quot; ability.</characteristic>
      </characteristics>
    </profile>
    <profile name="Agile Reflexes" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities" hidden="false" id="4a45-e03b-221a-0345">
      <characteristics>
        <characteristic name="Description" typeId="9b8f-694b-e5e-b573">While this unit makes a fallback move add 1D3 to its movement range. It can also shoot after making a fallback move.</characteristic>
      </characteristics>
