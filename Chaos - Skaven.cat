                    <profile name="Rotted Lands" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities" hidden="false" id="93b0-e26c-7be9-8241">
                      <characteristics>
                        <characteristic name="Description" typeId="9b8f-694b-e5e-b573">The bearer may select a terrain feature within 7&quot; of them, non-Pestilens units that are in or enter 3&quot; of the terrain feature take 1 mortal wound.</characteristic>
                      </characteristics>
                    </profile>
                  </profiles>
                  <constraints>
                    <constraint type="max" value="1" field="selections" scope="parent" shared="true" id="d1d0-5184-54ea-65d4" includeChildSelections="false"/>
                    <constraint type="max" value="1" field="selections" scope="force" shared="true" id="22c9-1803-93a0-b0f2" includeChildSelections="true" includeChildForces="true"/>
