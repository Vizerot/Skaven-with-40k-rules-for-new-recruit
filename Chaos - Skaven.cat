        <profile name="Rolling Doom" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities" hidden="false" id="ae8f-f683-f498-8b0e">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">This unit can pass through **Infantry** models and the engagement ranges of enemy units, but it cannot end that move in combat. Then, pick up to 3 enemy units that this unit passed across during that move to be the targets. Roll a D6 each model in that unit that this unit passed through, on 3+ that model takes 1D3 mortal wounds.</characteristic>
          </characteristics>
        </profile>
