        <profile name="Future Planning" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities" hidden="false" id="1649-db18-5fff-3135">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">While this model is leading a unit: the attached unit can use the *Suppresive Fire* ability.</characteristic>
          </characteristics>
        </profile>
        <profile name="Suppresive Fire" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities" hidden="false" id="ec8f-64ab-e381-50a8">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">During your shooting phase, instead of attacking you may pick an enemy unit in range. If this unit moves before the start of your next shooting phase, make a ranged attack against it and lower its movement range by the amount of damage dealt. This ability can&apos;t lower the enemies movement below 3&apos;&apos; and can&apos;t target units with the benefit of cower.</characteristic>
          </characteristics>
        </profile>
        <profile name="Overwhelming Fire" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities" hidden="false" id="ab6a-11ce-1814-fd10">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">Add 1 to the hit roll for this unit’s **Ratling Gun** for attacks that target an enemy unit that has 5 or more models.</characteristic>
          </characteristics>
        </profile>
        <profile name="Leader" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities" hidden="false" id="e3df-8d5f-3b9d-b02d">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">This model can be attached to the following units:
■ Ratling Gus</characteristic>
          </characteristics>
        </profile>
      </profiles>
