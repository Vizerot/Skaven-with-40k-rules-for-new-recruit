                    <constraint type="max" value="1" field="selections" scope="force" shared="true" id="5b7f-cb25-2fd0-781e" includeChildSelections="true" includeChildForces="true"/>
                  </constraints>
                  <profiles>
                    <profile name="Short-tempered" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities" hidden="false" id="11ae-c387-b479-245a">
                      <characteristics>
                        <characteristic name="Description" typeId="9b8f-694b-e5e-b573">Add 1 to advance rolls and charge rolls for friendly SKAVEN units while they are wholly within 13&quot; of the bearer.</characteristic>
                      </characteristics>
                    </profile>
                  </profiles>
                  <costs>
                    <cost name="pts" typeId="51b2-306e-1021-d207" value="15"/>
                    <cost name="Crusade Points" typeId="b03b-c239-15a5-da55" value="0"/>
