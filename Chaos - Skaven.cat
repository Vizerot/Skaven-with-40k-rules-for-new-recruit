        </profile>
        <profile name="Bubonic Barrage" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities" hidden="false" id="5b8e-b07c-bbcf-a9ef">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">Each time this unit uses a Shoot ability, if all of its attacks targeted the same enemy unit, after that ability has been resolved, roll a dice. If the result is equal to or less than the number of models in that enemy unit that were slain by attacks made by this unit’s **Plagueclaw Catapult** this phase, that enemy unit has **Fight Last** for the rest of the turn.</characteristic>
          </characteristics>
        </profile>
      </profiles>
