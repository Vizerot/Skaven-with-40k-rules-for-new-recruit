          </characteristics>
        </profile>
        <profile name="Warp Devastation" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities" hidden="false" id="0036-2812-cf30-009e">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">While this model is leading a unit: the attached unit benefits from the **Explosive Payload** ability.</characteristic>
          </characteristics>
        </profile>
        <profile name="Explosive Payload" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities" hidden="false" id="b70f-e6f4-ca40-e601">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">All Weapons with Blast add 2 to the attacks characteristics instead of 1 for every 5 models in a unit.</characteristic>
          </characteristics>
        </profile>
        <profile name="More-More Doom!" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities" hidden="false" id="89af-e226-9800-3cdf">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">On your shooting phase if this model has not moved this turn you may roll one D6. On a 2+ set the damage characteristic for **Doomrocket - Frag** and **Doomrocket-Krak** to D3 + 3 until the end of the phase. On a 1, inflict D3 mortal wounds to this unit.</characteristic>
          </characteristics>
        </profile>
        <profile name="Leader" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities" hidden="false" id="73b6-e176-24de-024e">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">This model can be attached to the following units:
■ Acolyte Globadiers
■ Poison Wind Mortars</characteristic>
          </characteristics>
        </profile>
      </profiles>
      <selectionEntries>
