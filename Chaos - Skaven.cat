        <profile name="Leader" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities" hidden="false" id="cc22-ea16-c466-9e40">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">This model can be attached to the following units:
■ **Brood Horror**
■ **Rat Ogre Pack**
■ **Wolf Rats**
■ **Giant Rats**</characteristic>
          </characteristics>
        </profile>
