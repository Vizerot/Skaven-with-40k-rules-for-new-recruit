        <profile name="Corrupting Influence" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities" hidden="false" id="7636-7645-2af3-4791">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">Subtract 1 from Save and Invulnerable Save rolls for enemy units while they are within 13&quot; of this unit.</characteristic>
          </characteristics>
        </profile>
        <profile name="Blessed Pox" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities" hidden="false" id="81db-9726-82cd-bd50">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">At the start of your command phase, bring back 1D3 wounds to a friendly **Pestilens** units within 13&quot; of this unit. If all models in that unit have their starting number of wounds, but that unit is not at its Starting Strength, bring back a destroyed model to that unit with 1D3 Wounds. If the target unit has the **Battleline** Keyword, bring back 1D3 models instead.</characteristic>
          </characteristics>
        </profile>
        <profile name="Plague Priest on Plague Furnace" typeId="c547-1836-d8a-ff4f" typeName="Unit" hidden="false" id="a749-7305-bc47-d7a2">
