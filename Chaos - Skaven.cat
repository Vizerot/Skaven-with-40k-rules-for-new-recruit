      <profiles>
        <profile name="Plagued Sacrifice" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities" hidden="false" id="0bea-2443-1a15-a9d1">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">When a **Pestilens** unit within 6&quot; of this unit uses a ranged attack, add 2 to the Damage characterictis of that attack and remove 1D3 models from this unit.</characteristic>
          </characteristics>
        </profile>
        <profile name="Cowardly (For a Skaven)" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities" hidden="false" id="e317-7f25-8ff0-1e88">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">During your command phase. If there are no **Character** units within 6&quot; of this unit, make a battleshock test.</characteristic>
          </characteristics>
        </profile>
        <profile name="Skaven Slaves" typeId="c547-1836-d8a-ff4f" typeName="Unit" hidden="false" id="f577-c4cb-067a-4d2f">
          <characteristics>
            <characteristic name="M" typeId="e703-ecb6-5ce7-aec1">5&quot;</characteristic>
