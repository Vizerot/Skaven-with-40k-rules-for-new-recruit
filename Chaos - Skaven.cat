        <profile name="Seething Swarm" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities" hidden="false" id="6d5c-5bf9-a688-9585">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">At the beginning of each player&apos;s command phase. Return D3 slain non-character models to this unit.</characteristic>
          </characteristics>
        </profile>
        <profile name="Expandable" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities" hidden="false" id="d594-8df2-1827-1dd1">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">During your enemy&apos;s Shooting or Fighting phase after the target has been selected. When a Character unit within 3&quot; of this unit is targeted by a attack, the attack is forced to attack this unit instead with +2 to hit and +3 to number of attacks.</characteristic>
          </characteristics>
        </profile>
        <profile name="Cowardly (For a Skaven)" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities" hidden="false" id="2e36-1c5e-15c8-780e">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">During any phase. If there are no CHARACTER units within 6&quot; of this unit, make a battleshock test.</characteristic>
          </characteristics>
        </profile>
        <profile name="Strength in Numbers" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities" hidden="false" id="c6b4-7408-1d36-1e9a">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">When 2 or more units with this ability are within 3&quot; of eachother they all gain +1 to hit and + 2 to their toughness.</characteristic>
          </characteristics>
        </profile>
        <profile name="Skaven Slaves" typeId="c547-1836-d8a-ff4f" typeName="Unit" hidden="false" id="5359-7b06-6f89-dcc7">
          <characteristics>
            <characteristic name="M" typeId="e703-ecb6-5ce7-aec1">6&quot;</characteristic>
