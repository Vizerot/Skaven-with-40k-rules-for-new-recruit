    <profile name="Hidden Amongst The Many" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities" hidden="false" id="8048-a67a-bc5c-b929">
      <characteristics>
        <characteristic name="Description" typeId="9b8f-694b-e5e-b573">If this CHARACTER is within 3&quot; of one or more other friendly SKAVEN units, this model has the **Lone Operative** ability.</characteristic>
      </characteristics>
    </profile>
    <profile name="Sweep of Flames" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities" hidden="false" id="43f4-3437-7eef-8109">
      <characteristics>
        <characteristic name="Description" typeId="9b8f-694b-e5e-b573">If this unit&apos;s Torrent weapon is targeting an enemy unit that is within 3&quot; of another enemy unit, each enemy unit is targeted by the attack.</characteristic>
      </characteristics>
    </profile>
    <profile name="Damaged: 1-5 Wounds Remaining" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities" hidden="false" id="6eac-369a-f9e3-cf11">
      <characteristics>
        <characteristic name="Description" typeId="9b8f-694b-e5e-b573">While this model has 1-5 wounds remaining, each time this model makes an attack, subtract 1 from the Hit roll.</characteristic>
      </characteristics>
    </profile>
    <profile name="Regenerating Monstrosity" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities" hidden="false" id="b6c3-e0d6-5261-183a">
      <characteristics>
        <characteristic name="Description" typeId="9b8f-694b-e5e-b573">At the start of each player’s Command phase, this model regains up to 2D3 lost wounds.</characteristic>
      </characteristics>
    </profile>
    <profile name="➤ Winds of Plague - Gale" typeId="f77d-b953-8fa4-b762" typeName="Ranged Weapons" hidden="false" id="1b84-baab-3ff7-e66d">
      <characteristics>
        <characteristic name="Range" typeId="9896-9419-16a1-92fc">16&quot;</characteristic>
        <characteristic name="A" typeId="3bb-c35f-f54-fb08">3</characteristic>
        <characteristic name="BS" typeId="94d-8a98-cf90-183e">-</characteristic>
