      <profiles>
        <profile name="Avalanche of Flesh" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities" hidden="false" id="ab55-332c-5c29-3d01">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">Each time this model ends a Charge move, select one enemy unit within Engagement Range of it and roll one D6: on a 2-3, that enemy unit suffers D3 mortal wounds; on a 4-5, that enemy unit suffers 3 mortal wounds; on a 6, that enemy unit suffers D3+3 mortal wounds</characteristic>
          </characteristics>
        </profile>
        <profile name="Too Horrible to Die" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities" hidden="false" id="4c94-c78f-29f8-ba66">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">The first time this unit would be destroyed, before removing it from the battlefield, roll a dice and apply the corresponding effect:
- **1 Dead**: This unit is destroyed.
- **2-3 The Rats Emerge**: This unit dies and creates 3 **Rat Swarm** units in its place.
- **4-6 It’s Alive!**: This unit is not destroyed. Heal (D6) this unit.</characteristic>
          </characteristics>
        </profile>
        <profile name="Hell Pit Abomination" typeId="c547-1836-d8a-ff4f" typeName="Unit" hidden="false" id="5020-325c-09c9-7cae">
