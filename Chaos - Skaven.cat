                        <characteristic name="Description" typeId="9b8f-694b-e5e-b573">**Plague Priest* models only. Friendly **Skaven** unit within 16&quot; of the bearer are considered **Pestilens** units.</characteristic>
                      </characteristics>
                    </profile>
                  </profiles>
                  <constraints>
