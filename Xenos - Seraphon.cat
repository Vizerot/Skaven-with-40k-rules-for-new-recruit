    <profile name="Terror From The Old World" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities" hidden="false" id="414e-7e9b-6190-9313">
      <characteristics>
        <characteristic name="Description" typeId="9b8f-694b-e5e-b573">Subtract 3 from Objective Control of enemy units within engangment range of this unit. If that unit has 0 or less Objective Control after the subtraction, it must take a battleshock test in its next command phase.</characteristic>
      </characteristics>
    </profile>
    <profile name="Attack From On High" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities" hidden="false" id="2ba6-774c-dac8-91bb">
      <characteristics>
        <characteristic name="Description" typeId="9b8f-694b-e5e-b573">Subtract 1 from hit rolls for ranged attacks that target this unit.
This ability doesn&apos;t apply to attacks made by units with the **Fly** Keyword or by weapons with **Anti-****Fly** x.</characteristic>
      </characteristics>
    </profile>
