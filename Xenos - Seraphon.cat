    <profile name="Otapatl&apos;s Dartpipe" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities" hidden="false" id="3254-fea8-a468-4a1a">
      <characteristics>
        <characteristic name="Description" typeId="9b8f-694b-e5e-b573">When this units Otapatl makes an attack with Otapatl&apos;s Dartpipe, roll one D6. On a 4+, inflict 1 mortal wounds for each succesful hit in addition to making a normal attack.</characteristic>
      </characteristics>
    </profile>
    <profile name="Kixi-Taka, The Diviner" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities" hidden="false" id="a73d-a574-eddd-d1a2">
      <characteristics>
        <characteristic name="Description" typeId="9b8f-694b-e5e-b573">While this unit’s Kixi-Taka, the Diviner, is on the battlefield, it has the **Psyker** Keyword.</characteristic>
      </characteristics>
    </profile>
    <profile name="Klaq-Trok " typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities" hidden="false" id="b9c4-c7b3-45fe-2513">
      <characteristics>
        <characteristic name="Description" typeId="9b8f-694b-e5e-b573">While this unit’s Klaq-Trok is on the battlefield, ignore the first instance of damage that would be allocated to this unit each battle round.</characteristic>
      </characteristics>
    </profile>
    <profile name="Acid-Fuelled Flame" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities" hidden="false" id="63ee-b064-724b-450b">
      <characteristics>
        <characteristic name="Description" typeId="9b8f-694b-e5e-b573">In your shooting phase after resolving all attacks, if any wounds were allocated to an enemy unit by those attacks, subtract 1 from save rolls for that enemy unit for the rest of the phase.</characteristic>
      </characteristics>
    </profile>
