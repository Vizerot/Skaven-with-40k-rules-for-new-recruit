    <profile name="Scaled Defenders" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities" hidden="false" id="159d-3a2b-df78-70b5">
      <characteristics>
        <characteristic name="Description" typeId="9b8f-694b-e5e-b573">If this unit is attached to a leader unit and either this unit or said leader unit are selected as a target of an attack, the attacked unit ignores any negative modifiers to its save rolls including the attacks AP characteristic.</characteristic>
      </characteristics>
    </profile>
