                </selectionEntry>
                <selectionEntry type="upgrade" import="true" name="Consume the Enemy" hidden="false" id="bdbc-82d1-4612-f037">
                  <profiles>
                    <profile name="Consume the Enemy" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities" hidden="false" id="8449-648e-564f-2b5c">
                      <characteristics>
                        <characteristic name="Description" typeId="9b8f-694b-e5e-b573">When this unit destroys an enemy unit, heal this unit 1D3 lost wounds. If that unit had 5 or more models or had the **Monster** Keyword, heal 2D3 Instead.</characteristic>
                      </characteristics>
                    </profile>
                  </profiles>
