    <profile name="Monstrous Strength" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities" hidden="false" id="1829-5c58-8f1f-9c09">
      <characteristics>
        <characteristic name="Description" typeId="9b8f-694b-e5e-b573">If this character has an attached unit, both this character and that attached unit gain +1 to the strength characteristic of their melee attacks</characteristic>
      </characteristics>
    </profile>
