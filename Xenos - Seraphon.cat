                </selectionEntry>
                <selectionEntry type="upgrade" import="true" name="Smell of Blood" hidden="false" id="dc18-103e-8ade-4fda">
                  <profiles>
                    <profile name="Smell of Blood" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities" hidden="false" id="413d-86ba-55bc-a429">
                      <characteristics>
                        <characteristic name="Description" typeId="9b8f-694b-e5e-b573">If this units **Companion** Weapon deals at least one wound to the enemy unit, all non **Companion** weapons in this unit can reroll wound rolls of 1 when attacking the same unit until the end of the turn.</characteristic>
                      </characteristics>
                    </profile>
                  </profiles>
