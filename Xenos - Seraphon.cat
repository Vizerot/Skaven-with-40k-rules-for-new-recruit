              <profiles>
                <profile name="Controlled Rage" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities" hidden="false" id="f64b-50d8-fec1-c527">
                  <characteristics>
                    <characteristic name="Description" typeId="9b8f-694b-e5e-b573">**COST**: 1 CP.


**WHEN**: Your Command Phase.


**TARGET**: Pick a friendly **Skink Handler** unit.


**EFFECT**: All **Beast** units in 12&quot; gain 1 rage token unless they are Battle-Shocked, if Battle-Shocked they gain no rage tokens but are no longer Battle-Shocked.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
              <constraints>
