    <profile name="Cold-Blooded Unity" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities" hidden="false" id="2219-e841-25b9-076f">
      <characteristics>
        <characteristic name="Description" typeId="9b8f-694b-e5e-b573">Add 1 to hit rolls for this unit’s attacks if they target an enemy unit that was targeted by at least one attack made by a friendly Raptadon Hunters unit in the same turn.</characteristic>
