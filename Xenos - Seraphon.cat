    <profile name="Spearhead of The Charge" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities" hidden="false" id="9024-74c3-f5bb-7658">
      <characteristics>
        <characteristic name="Description" typeId="9b8f-694b-e5e-b573">f this unit charged this turn, add 2 to charge rolls for friendly **Saurus** **Mounted** units while they are wholly within 18&quot; of this unit for the rest of this charge phase. Add 4 to charge rolls instead if that unit is a **Saurus Knights** unit.</characteristic>
      </characteristics>
    </profile>
    <profile name="Itxi Grubs" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities" hidden="false" id="f6a7-f3b8-c31b-5007">
      <characteristics>
        <characteristic name="Description" typeId="9b8f-694b-e5e-b573">Twice per battle in your command phase you may use this ability, when you use this ability either this unit or a **Psyker** unit within 3&quot; can reroll wound rolls for all their weapons attacks using **Psychic** Weapons until your next command phase. Only one instance of this effect can be applied to the same unit.</characteristic>
      </characteristics>
    </profile>
    <profile name="Sunburst Standard of Hexoatl " typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities" hidden="false" id="003d-a39c-37a5-d098">
      <characteristics>
        <characteristic name="Description" typeId="9b8f-694b-e5e-b573">Friendly **Saurus** units within 12&quot; can&apos;t fail battleshock tests.</characteristic>
      </characteristics>
    </profile>
    <profile name="Cobra Mace of Mazdamundi" typeId="8a40-4aaa-c780-9046" typeName="Melee Weapons" hidden="false" id="16e5-7b78-5af6-08e3">
