      </characteristics>
    </profile>
    <profile name="Frenzied Skirmishers" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities" hidden="false" id="c648-827c-6492-201c">
      <characteristics>
        <characteristic name="Description" typeId="9b8f-694b-e5e-b573">In its fight phase after this unit has attacked an enemy unit, this unit may make a fall back move before the attacked units fight back phase.
This unit may make a fall back move even if it has charged this turn.</characteristic>
      </characteristics>
    </profile>
    <profile name="Ripperdactyl’s Tearing Jaws" typeId="8a40-4aaa-c780-9046" typeName="Melee Weapons" hidden="false" id="ff36-5fca-5169-5171">
