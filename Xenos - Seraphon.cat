        <characteristic name="S" typeId="ab33-d393-96ce-ccba">13</characteristic>
        <characteristic name="AP" typeId="41a0-1301-112a-e2f2">-3</characteristic>
        <characteristic name="D" typeId="3254-9fe6-d824-513e">3</characteristic>
        <characteristic name="Keywords" typeId="893f-9000-ccf7-648e">Anti-Infantry 2+, Anti-Monster 2+, Anti-Vehicle 2+, Lethal Hits, Devastating Wounds</characteristic>
      </characteristics>
    </profile>
    <profile name="Spirit of The Jungle" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities" hidden="false" id="cd1c-fc4c-0c43-231a">
      <characteristics>
        <characteristic name="Description" typeId="9b8f-694b-e5e-b573">When this unit is deployed using **Deep Strike** it can be placed anywhere outside 3&quot; of any enemy units, if its deployed within 3&quot; of a friendly unit below its starting strength it can also move in the same turn.</characteristic>
      </characteristics>
    </profile>
