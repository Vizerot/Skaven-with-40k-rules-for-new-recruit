            <constraint type="max" value="1" field="selections" scope="parent" shared="true" id="ebea-bb62-f26f-57ae" includeChildSelections="false"/>
          </constraints>
          <selectionEntries>
            <selectionEntry type="upgrade" import="true" name="Chotec, The Invigorator" hidden="false" id="262c-9c41-b75a-6550">
              <profiles>
                <profile name="Chotec, The Invigorator" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities" hidden="false" id="3c3f-eea1-c6ea-f030">
                  <characteristics>
                    <characteristic name="Description" typeId="9b8f-694b-e5e-b573">In your command phase pick a unit below its starting strength and restore 2 lost wound to it, at the begining of your enemies command phase restore another 2 lost wounds to the same unit.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
              <constraints>
                <constraint type="max" value="1" field="selections" scope="force" shared="true" id="dc22-a64a-c6e0-3aec" includeChildSelections="false"/>
              </constraints>
            </selectionEntry>
            <selectionEntry type="upgrade" import="true" name="Itzl, The Tamer" hidden="false" id="2da6-9193-027a-b135">
              <profiles>
                <profile name="Itzl, The Tamer" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities" hidden="false" id="bd89-a2a3-0c83-5945">
                  <characteristics>
                    <characteristic name="Description" typeId="9b8f-694b-e5e-b573">Weapons used by friendly Seraphon Beast and Monster units have **Sustained Hits** 2.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
              <constraints>
                <constraint type="max" value="1" field="selections" scope="force" shared="true" id="29d1-0f53-69f7-2001" includeChildSelections="false"/>
              </constraints>
            </selectionEntry>
            <selectionEntry type="upgrade" import="true" name="Quetzl, The Preserver" hidden="false" id="451a-b145-93dd-4d90">
              <profiles>
                <profile name="Quetzl, The Preserver" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities" hidden="false" id="4fa9-56a6-c6dc-d709">
                  <characteristics>
                    <characteristic name="Description" typeId="9b8f-694b-e5e-b573">Subtract 1 from the AP characteristic of melee weapons for attacks that target friendly Seraphon units that are wholly within your deployment zone. If you control more Objective Points in No Man&apos;s Land than your opponent, No Man&apos;s Land counts as friendly territory.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
              <constraints>
                <constraint type="max" value="1" field="selections" scope="force" shared="true" id="3603-ed43-5b45-16e1" includeChildSelections="false"/>
              </constraints>
            </selectionEntry>
            <selectionEntry type="upgrade" import="true" name="Tepok, The Seer" hidden="false" id="1f32-8318-eba1-e7e6">
              <profiles>
                <profile name="Tepok, The Seer" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities" hidden="false" id="183f-5cf5-5d23-fc76">
                  <characteristics>
                    <characteristic name="Description" typeId="9b8f-694b-e5e-b573">Add 1 to Wound rolls and Attacks characteristic for friendly Seraphon Psyker units.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
              <constraints>
                <constraint type="max" value="1" field="selections" scope="force" shared="true" id="4425-62f5-0771-f232" includeChildSelections="false"/>
              </constraints>
            </selectionEntry>
            <selectionEntry type="upgrade" import="true" name="Sotek, The Deliverer" hidden="false" id="32d5-bfba-8513-c2db">
              <profiles>
                <profile name="Sotek, The Deliverer" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities" hidden="false" id="fb2a-a650-215f-c4b6">
                  <characteristics>
                    <characteristic name="Description" typeId="9b8f-694b-e5e-b573">Add 2&quot; to the Move characteristic of friendly Seraphon units, Skink units also don&apos;t need to spend extra movement when moving verticaly or through difficult terrain.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
              <constraints>
                <constraint type="max" value="1" field="selections" scope="force" shared="true" id="1ce3-2145-b3ab-0dd7" includeChildSelections="false"/>
              </constraints>
            </selectionEntry>
          </selectionEntries>
        </selectionEntry>
      </selectionEntries>
