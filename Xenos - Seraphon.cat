    <profile name="Scry The Stars" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities" hidden="false" id="a38c-e3b3-fa5d-f515">
      <characteristics>
        <characteristic name="Description" typeId="9b8f-694b-e5e-b573">Roll xD6, x being equal to the current battle round number. For each 3+, pick a friendly SERAPHON unit wholly within 18&quot; of this unit. That unit has **Invulnerable (5+)** until the start of your next command phase.</characteristic>
      </characteristics>
    </profile>
    <profile name="Celestial Doom" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities" hidden="false" id="8cf1-d8a4-02e2-6078">
      <characteristics>
        <characteristic name="Description" typeId="9b8f-694b-e5e-b573">In your command phase pick a visible enemy unit within 18&quot; to be the target, then roll 2D6.
If the combined roll of the dice is 7 or higher, the target unit can&apos;t make **Invulnerable** and **Feel No Pain** rolls until your next command phase.</characteristic>
      </characteristics>
    </profile>
    <profile name="Astromancer Staff" typeId="8a40-4aaa-c780-9046" typeName="Melee Weapons" hidden="false" id="37f5-a456-9ad8-e6ed">
